<% content_for :layout_content do %>
	<style>
		.org-settings-layout {
			width: min(1200px, 100% - 2rem);
			margin: 1.25rem auto 2.5rem;
			display: grid;
			gap: 1rem;
		}

		.org-settings-layout__nav {
			background: #ffffff;
			border: 1px solid #dfe4ea;
			border-radius: 14px;
			padding: 0.65rem;
			display: flex;
			flex-wrap: wrap;
			gap: 0.5rem;
		}

		.org-settings-layout__nav-link {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			text-decoration: none;
			border-radius: 10px;
			padding: 0.5rem 0.9rem;
			border: 1px solid #c7d2fe;
			color: #1d4ed8;
			font-weight: 600;
			background: #eff6ff;
		}

		.org-settings-layout__nav-link.is-active {
			background: #1d4ed8;
			border-color: #1d4ed8;
			color: #ffffff;
		}

		.org-settings-layout__body {
			min-width: 0;
		}

		@media (max-width: 700px) {
			.org-settings-layout {
				width: min(1200px, 100% - 1rem);
				margin: 0.9rem auto 2rem;
			}

			.org-settings-layout__nav {
				flex-wrap: nowrap;
				overflow-x: auto;
				-webkit-overflow-scrolling: touch;
				padding: 0.55rem;
			}

			.org-settings-layout__nav-link {
				flex: 0 0 auto;
				white-space: nowrap;
				padding: 0.48rem 0.8rem;
				font-size: 0.88rem;
			}
		}
	</style>

	<section class="org-settings-layout">
		<nav class="org-settings-layout__nav" aria-label="Organisation settings navigation">
			<%= link_to "Overview", settings_organisation_path(@organisation), class: "org-settings-layout__nav-link #{'is-active' if action_name == 'index'}" %>
			<%= link_to "Customisations", settings_customisations_organisation_path(@organisation), class: "org-settings-layout__nav-link #{'is-active' if action_name == 'customisations'}" %>
			<%= link_to "Event Defaults", settings_events_defaults_organisation_path(@organisation), class: "org-settings-layout__nav-link #{'is-active' if action_name == 'events_defaults'}" %>
			<%= link_to "Members", settings_members_organisation_path(@organisation), class: "org-settings-layout__nav-link #{'is-active' if action_name == 'members' || action_name == 'update_member'}" %>
			<%= link_to "Roles", settings_roles_organisation_path(@organisation), class: "org-settings-layout__nav-link #{'is-active' if action_name == 'roles'}" %>
			<%= link_to "Custom Branding", settings_custom_branding_organisation_path(@organisation), class: "org-settings-layout__nav-link #{'is-active' if action_name == 'custom_branding'}" %>
		</nav>

		<div class="org-settings-layout__body">
			<%= yield %>
		</div>
	</section>
<% end %>

<%= render template: "layouts/application" %>
