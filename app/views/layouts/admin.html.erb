<!DOCTYPE html>
<html>
	<head>
		<title><%= content_for(:title) || "Admin | Eventful" %></title>
		<meta name="viewport" content="width=device-width,initial-scale=1">
		<%= csrf_meta_tags %>
		<%= csp_meta_tag %>

		<style>
		    .admin-layout__header {
		        position: sticky;
		        top: 0;
		        z-index: 20;
		        display: grid;
		        grid-template-columns: auto 1fr auto;
		        align-items: center;
		        gap: 0.8rem;
		        padding: 0.85rem 1rem;
		        border-bottom: 1px solid <%= current_user.user_color(0.4) %>;
		        background: rgba(15, 23, 42, 0.9);
		        backdrop-filter: blur(6px);
		    }

		    .admin-layout__logout {
		        border: 1px solid rgba(248, 113, 113, 0.9);
		        background: rgba(239, 68, 68, 0.4);
		        color: #fecaca;
		        border-radius: 10px;
		        padding: 0.35rem 0.7rem;
		        font-weight: 700;
		        cursor: pointer;
		    }

		    .admin-layout__logout:hover {
		        background: rgba(239, 68, 68, 0.6);
		    }

            .admin-layout__dropdown form {
                margin: 0;
            }

            .admin-layout__dropdown button {
                width: 100%;
                text-align: left;
                padding: 0.6rem 1rem;
                cursor: pointer;
            }
		</style>

		<%= yield :head %>

		<%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
		<%= javascript_importmap_tags %>
	</head>

	<body class="admin-layout">
		<header class="admin-layout__header">
			<div class="admin-layout__brand">
				<%= link_to "Eventful Admin", organisations_path, class: "admin-layout__brand-link" %>
			</div>

			<nav class="admin-layout__nav" aria-label="Admin navigation">
				<%= link_to "Dashboard", organisations_path, class: "admin-layout__nav-link" %>
				<%= link_to "Events", events_path, class: "admin-layout__nav-link" %>
				<%= link_to "New Organisation", new_organisation_path, class: "admin-layout__nav-link" %>
			</nav>				<div class="admin-layout__session" data-controller="dropdown" data-action="click@window->dropdown#clickOutside">
					<% if respond_to?(:current_user) && current_user.present? %>
						<button type="button" class="admin-layout__user" data-dropdown-trigger="" data-action="click->dropdown#toggle" aria-haspopup="true" aria-expanded="false">
							<%= render "username", scale: 0.75 %>
						</button>
						<div class="admin-layout__dropdown" data-dropdown-target="menu" hidden>
							<%= button_to "Sign out", logout_path, method: :delete, class: "admin-layout__logout" %>
						</div>
					<% end %>
				</div>
		</header>

		<main class="admin-layout__main">
			<% flash.each do |type, message| %>
				<div class="flash flash-<%= type %>"><%= message %></div>
			<% end %>

			<%= yield %>
		</main>
	</body>
</html>
