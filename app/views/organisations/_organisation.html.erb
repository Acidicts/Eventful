<div class="org-card">
    <% if organisation.img%>
        <img src="<%= organisation.img %>" alt="<%= organisation.name %>" class="org-card__image">
    <% end %>
    <% if organisation.name %>
        <h2 class="org-card__title"><%= organisation.name %></h2>
    <% end %>
    <% if organisation.description %>
        <p class="org-card__description"><%= organisation.description %></p>
    <% end %>
    <%= button_to "Goto", dashboard_organisation_path(organisation), method: :get, class: "btn btn-primary org-card__action" %>
</div>