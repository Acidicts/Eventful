<style>
    .goto_btn {
        background-color: #334155;
        border: 2px solid #3f6191;
        color: white;
        transition: all 0.15s ease;
    }

    .goto_btn:hover {
        border-radius: 10px;
        padding: 0.55rem 1rem;
        background-color: #3f6191;
        border: 2px solid #334155;
        color: white;
    }

    .favorite-btn {
      border: 1px solid transparent;
      background: transparent;
      color: #6b7280;
      font-size: 1.125rem;
      line-height: 1;
      padding: 0.1rem 0.35rem;
      border-radius: 0.4rem;
      transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
      font-weight: bold;
      min-width: 32px;
      font-size: 2rem;
    }

    .favorite-btn.active {
      color: #f59e0b;
      background: rgba(245, 158, 11, 0.14);
      border-color: rgba(245, 158, 11, 0.3);
    }

    .favorite-btn:hover {
      color: #d97706;
      background: rgba(253, 230, 138, 0.3);
      transform: translateY(-1px);
    }

    .event-card__icon {
        width: 64px;
        height: 64px;
        object-fit: cover;
        border-radius: 0.5rem;
    }

    .event-card {
        width: min(100%, 395px);
        min-height: 84px;
        padding: 15px;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .event-card__body {
        min-width: 0;
    }

    .event-card__title {
        margin: 0;
        overflow-wrap: anywhere;
    }

    .event-card__actions {
        display: inline-flex;
        margin-left: auto;
        gap: 0.5rem;
        flex-shrink: 0;
    }

    @media (max-width: 500px) {
        .event-card {
            width: 100%;
            height: auto;
            padding: 0.75rem;
            gap: 0.75rem;
            display: flex;
            flex-direction: column;
        }

        .event-card__icon {
            width: 52px;
            height: 52px;
        }

        .event-card__title {
            font-size: 1rem;
            line-height: 1.2;
        }

        .event-card__meta {
            font-size: 0.8rem !important;
        }

        .event-card__actions {
            display: flex;
            margin-left: 0;
            align-self: center;
            flex-direction: column;
            align-items: center;
        }

        .favorite-btn {
            font-size: 1.6rem;
            padding: 0 0.3rem;
            min-width: 28px;
        }
    }
</style>

<div class="event-card">
    <% if organisation.img.present? %>
        <div class="event-card__icon-wrap">
            <%= image_tag organisation.img, class: "event-card__icon" %>
        </div>
    <% end %>
    <div class="event-card__body">
        <% if organisation.name %>
            <h2 class="event-card__title"><%= organisation.name %></h2>
        <% end %>

        <% if organisation.parent_org.present? %>
            <p class="event-card__meta" style="margin: 0.25rem 0 0; color: #475569; font-size: 0.9rem;">Parent organisation: <%= organisation.parent_org.name %></p>
        <% end %>
    </div>
    <div class="event-card__actions">
        <% if current_user.favorited?(organisation) %>
            <%= button_to "★", favorite_organisation_path(organisation), method: :delete, class: "favorite-btn active", id: "favorite-organisation-btn" %>
        <% else %>
            <%= button_to "☆", favorite_organisation_path(organisation), method: :post, class: "favorite-btn", id: "favorite-organisation-btn" %>
        <% end %>
        <%= button_to "Goto", dashboard_organisation_path(organisation), method: :get, class: "btn btn-primary event-card__action goto_btn" %>
    </div>
</div>