<style>
  .org-dashboard {
    max-width: 1120px;
    margin: 1.5rem auto;
    padding: 0 1rem 2rem;
    color: #0f2740;
  }

  .org-dashboard__hero {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    background: radial-gradient(circle at 15% 15%, rgba(255, 255, 255, 0.28), transparent 28%),
                linear-gradient(138deg, #003566 0%, #0077b6 52%, #00b4d8 100%);
    color: #fff;
    padding: 1.5rem;
    box-shadow: 0 16px 34px rgba(0, 44, 92, 0.28);
    display: grid;
    gap: 1.15rem;
    width: 100%;
  }

  .org-dashboard__hero::after {
    content: "";
    position: absolute;
    right: -90px;
    top: -90px;
    width: 240px;
    height: 240px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    pointer-events: none;
  }

  .org-dashboard__hero-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
  }

  .org-dashboard__title {
    margin: 0;
    font-size: clamp(1.7rem, 2.8vw, 2.35rem);
    line-height: 1.1;
    letter-spacing: 0.01em;
  }

  .org-dashboard__subtitle {
    margin: 0.45rem 0 0;
    max-width: 56ch;
    color: rgba(255, 255, 255, 0.9);
  }

  .org-dashboard__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    padding: 0.32rem 0.75rem;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .org-dashboard__actions {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    flex-wrap: wrap;
    position: relative;
    z-index: 1;
  }

  .org-dashboard__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    text-decoration: none;
    padding: 0.58rem 0.95rem;
    font-weight: 700;
    transition: transform 0.14s ease, box-shadow 0.14s ease, background-color 0.14s ease;
  }

  .org-dashboard__button:hover {
    transform: translateY(-1px);
  }

  .org-dashboard__button--solid {
    background: #fff;
    color: #0b4f86;
    box-shadow: 0 10px 20px rgba(7, 40, 74, 0.22);
  }

  .org-dashboard__button--ghost {
    background: rgba(255, 255, 255, 0.16);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.32);
  }

  .org-dashboard__kpis {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    gap: 0.75rem;
    position: relative;
    z-index: 1;
  }

  .org-dashboard__kpi {
    flex: 1 1 180px;
    min-width: 180px;
    background: rgba(255, 255, 255, 0.16);
    border: 1px solid rgba(255, 255, 255, 0.27);
    border-radius: 14px;
    padding: 0.8rem;
  }

  .org-dashboard__kpi-label {
    margin: 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.86);
  }

  .org-dashboard__kpi-value {
    margin: 0.2rem 0 0;
    font-size: clamp(1.2rem, 1.5vw, 1.55rem);
    font-weight: 800;
  }

  .org-dashboard__main {
    margin-top: 1rem;
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1rem;
  }

  .org-dashboard__panel {
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 16px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
    padding: 1rem;
  }

  .org-dashboard__panel-title {
    margin: 0;
    color: #0e3558;
    font-size: 1.1rem;
  }

  .org-dashboard__panel-subtitle {
    margin: 0.35rem 0 0;
    color: #5c6f83;
    font-size: 0.92rem;
  }

  .org-dashboard__stack {
    display: grid;
    gap: 0.8rem;
    margin-top: 0.95rem;
  }

  .org-dashboard__event {
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 12px;
    padding: 0.85rem;
    background: #fbfdff;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .org-dashboard__event-title {
    margin: 0;
    color: #0a4e87;
    font-size: 0.98rem;
    font-weight: 700;
    text-decoration: none;
  }

  .org-dashboard__event-title:hover {
    text-decoration: underline;
  }

  .org-dashboard__event-meta {
    margin: 0.35rem 0 0;
    color: #5f7286;
    font-size: 0.88rem;
  }

  .org-dashboard__badge {
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    font-size: 0.73rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    white-space: nowrap;
    text-transform: uppercase;
  }

  .org-dashboard__badge--live {
    background: rgba(16, 185, 129, 0.16);
    color: #047857;
  }

  .org-dashboard__badge--upcoming {
    background: rgba(14, 165, 233, 0.16);
    color: #0369a1;
  }

  .org-dashboard__badge--finished {
    background: rgba(148, 163, 184, 0.24);
    color: #334155;
  }

  .org-dashboard__progress {
    margin-top: 0.6rem;
    height: 8px;
    border-radius: 999px;
    overflow: hidden;
    background: #dbe8f4;
  }

  .org-dashboard__progress-fill {
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(90deg, #0077b6, #00b4d8);
  }

  .org-dashboard__small-metrics {
    margin-top: 0.95rem;
    display: grid;
    gap: 0.6rem;
  }

  .org-dashboard__small-metric {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #f2f8fd;
    border: 1px solid #d6e7f5;
    border-radius: 10px;
    padding: 0.58rem 0.72rem;
    color: #18415f;
    font-size: 0.9rem;
  }

  .org-dashboard__small-metric strong {
    color: #0a4e87;
  }

  .org-dashboard__attendee {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.65rem;
    align-items: center;
    border-bottom: 1px solid rgba(0, 0, 0, 0.07);
    padding: 0.68rem 0;
  }

  .org-dashboard__attendee:last-child {
    border-bottom: 0;
  }

  .org-dashboard__attendee-name {
    margin: 0;
    font-weight: 700;
    color: #143b5f;
  }

  .org-dashboard__attendee-meta {
    margin: 0.28rem 0 0;
    color: #63798e;
    font-size: 0.84rem;
  }

  .org-dashboard__empty {
    margin: 0.85rem 0 0;
    border: 1px dashed rgba(2, 62, 138, 0.3);
    border-radius: 12px;
    background: #f8fbff;
    color: #5c6e82;
    padding: 0.85rem;
  }

  .org-dashboard__footer-link {
    margin-top: 0.85rem;
  }

  .org-dashboard__footer-link a {
    color: #0a4e87;
    font-weight: 700;
    text-decoration: none;
  }

  .org-dashboard__footer-link a:hover {
    text-decoration: underline;
  }

  .org-dashboard__kpi {
    flex: 1 1 180px;
    min-width: 180px;
  }

  @media (max-width: 900px) {
    .org-dashboard__main {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .org-dashboard {
      margin: 1rem auto;
      padding: 0 0.8rem 1.4rem;
    }

    .org-dashboard__hero {
      padding: 1.05rem;
      border-radius: 16px;
    }

    .org-dashboard__event {
      padding: 0.72rem;
    }
  }
</style>

<% capacity_fill_percent = @total_capacity.positive? ? ((@attendee_count.to_f / @total_capacity) * 100).round : 0 %>

<section class="org-dashboard" aria-label="Organisation dashboard">
  <header class="org-dashboard__hero">
    <div class="org-dashboard__hero-head">
      <div>
        <span class="org-dashboard__meta">Organisation dashboard</span>
        <h1 class="org-dashboard__title"><%= @organisation.name %></h1>
      </div>
    </div>

    <div class="org-dashboard__kpis">
      <article class="org-dashboard__kpi">
        <p class="org-dashboard__kpi-label">Total events</p>
        <p class="org-dashboard__kpi-value"><%= @event_count %></p>
      </article>
      <article class="org-dashboard__kpi">
        <p class="org-dashboard__kpi-label">Active now</p>
        <p class="org-dashboard__kpi-value"><%= @active_events_count %></p>
      </article>
      <article class="org-dashboard__kpi">
        <p class="org-dashboard__kpi-label">Upcoming</p>
        <p class="org-dashboard__kpi-value"><%= @upcoming_events_count %></p>
      </article>
      <article class="org-dashboard__kpi">
        <p class="org-dashboard__kpi-label">Attendees</p>
        <p class="org-dashboard__kpi-value"><%= @attendee_count %></p>
      </article>
    </div>
  </header>

  <div class="org-dashboard__main">
    <section class="org-dashboard__panel" aria-labelledby="upcoming-events-title">
      <h2 id="upcoming-events-title" class="org-dashboard__panel-title">Upcoming events</h2>
      <p class="org-dashboard__panel-subtitle">
        Next five scheduled events for your organisation.
      </p>

      <% if @upcoming_events.any? %>
        <div class="org-dashboard__stack">
          <% @upcoming_events.each do |event| %>
            <% capacity = event.capacity.to_i %>
            <% attendee_count = event.attendees.count %>
            <% event_fill_percent = capacity.positive? ? ((attendee_count.to_f / capacity) * 100).round : 0 %>
            <% badge_class = if event.finished?
                               "org-dashboard__badge org-dashboard__badge--finished"
                             elsif event.start_date.present? && event.start_date <= Time.current
                               "org-dashboard__badge org-dashboard__badge--live"
                             else
                               "org-dashboard__badge org-dashboard__badge--upcoming"
                             end %>
            <% badge_label = if event.finished?
                               "Finished"
                             elsif event.start_date.present? && event.start_date <= Time.current
                               "Live"
                             else
                               "Upcoming"
                             end %>

            <article class="org-dashboard__event">
              <div>
                <%= link_to event.name.presence || "Untitled event", organisation_event_path(@organisation, event), class: "org-dashboard__event-title" %>
                <p class="org-dashboard__event-meta">
                  <% if event.start_date.present? %>
                    Starts <%= event.start_date.strftime("%b %-d, %Y %l:%M %p") %>
                  <% else %>
                    Start date not set
                  <% end %>
                  <% if event.location.present? %>
                    · <%= event.location %>
                  <% end %>
                </p>
                <div class="org-dashboard__progress" role="img" aria-label="Event capacity usage">
                  <div class="org-dashboard__progress-fill" style="width: <%= [event_fill_percent, 100].min %>%;"></div>
                </div>
                <p class="org-dashboard__event-meta">
                  <strong><%= attendee_count %></strong> attendee<%= attendee_count == 1 ? "" : "s" %>
                  <% if capacity.positive? %>
                    of <strong><%= capacity %></strong> capacity
                  <% else %>
                    with no capacity limit
                  <% end %>
                </p>
              </div>
              <span class="<%= badge_class %>"><%= badge_label %></span>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="org-dashboard__empty">No scheduled events yet. Create an event to start collecting signups.</p>
      <% end %>

      <p class="org-dashboard__footer-link">
        <%= link_to "Go to full events list", dashboard_events_organisation_path(@organisation) %>
      </p>
    </section>

    <aside class="org-dashboard__panel" aria-labelledby="attendance-health-title">
      <h2 id="attendance-health-title" class="org-dashboard__panel-title">Attendance health</h2>
      <p class="org-dashboard__panel-subtitle">
        Current intake and check-in status across all events.
      </p>

      <div class="org-dashboard__small-metrics">
        <div class="org-dashboard__small-metric">
          <span>New events this month</span>
          <strong><%= @recent_events_count %></strong>
        </div>
        <div class="org-dashboard__small-metric">
          <span>Total capacity</span>
          <strong><%= @total_capacity %></strong>
        </div>
        <div class="org-dashboard__small-metric">
          <span>Remaining spots</span>
          <strong><%= @available_spots %></strong>
        </div>
        <div class="org-dashboard__small-metric">
          <span>Capacity fill</span>
          <strong><%= capacity_fill_percent %>%</strong>
        </div>
        <div class="org-dashboard__small-metric">
          <span>Checked in</span>
          <strong><%= @signed_in_count %></strong>
        </div>
        <div class="org-dashboard__small-metric">
          <span>Checked out</span>
          <strong><%= @signed_out_count %></strong>
        </div>
      </div>


      <p class="org-dashboard__footer-link">
        <%= link_to "View all attendees", dashboard_attendees_organisation_path(@organisation) %>
      </p>
    </aside>
  </div>
</section>