<p>
  <strong>ID:</strong>
  <%= @event.id %>
</p>

<p>
  <strong>Name:</strong>
  <%= @event.name %>
</p>

<p>
  <strong>Description:</strong>
  <%= @event.description %>
</p>

<p>
  <strong>Organiser:</strong>
  <%= @event.organiser&.name || "TBA" %>
</p>

<p>
  <strong>Capacity:</strong>
  <%= @event.capacity %>
</p>

<p>
  <strong>Applied:</strong>
  <%= @event.attendees.count %>
</p>

<p>
  <strong>Location:</strong>
  <%= @event.location %>
</p>

<p>
  <strong>Start date:</strong>
  <% if @event.start_date %>
    <%= @event.start_date %>
  <% else %>
    TBA
  <% end %>
</p>
</p>
  <strong>End date:</strong>
  <% if @event.end_date %>
    <%= @event.end_date %>
  <% else %>
    TBA
  <% end %>
</p>

<p>
  <strong>Finished:</strong>
  <%= @event.finished? ? "Yes" : "No" %>
</p>

<p>
  <strong>Waiver:</strong>
  <% if @event.waiver.attached? %>
    <%= link_to "Download waiver", rails_blob_path(@event.waiver, disposition: "attachment") %>
  <% else %>
    none
  <% end %>
</p>

<p>
  <strong>Attendee count:</strong>
  <%= link_to "View Attendees", attendees_organisation_event_path(@organisation, @event) %>
</p>

<%= link_to 'Apply', apply_organisation_event_path(@organisation, @event) %>

<% if @event.apply_token.present? %>
  <p>Shareable apply link (no organisation required):
    <%= link_to public_apply_event_url(@event.apply_token), public_apply_event_url(@event.apply_token) %>
  </p>
<% end %>

<%= button_to 'Send QR Codes', send_qr_codes_organisation_event_path(@organisation, @event), method: :post %>

<%= link_to 'Edit', edit_organisation_event_path(@organisation, @event) %> |
<%= link_to 'Back', organisation_events_path(@organisation) %>