<section class="attendee-details">
  <header class="attendee-details__header">
    <div>
      <h1 class="attendee-details__title">Attendee details</h1>
      <p class="attendee-details__subtitle">Review registration details, waiver status, and attendee info.</p>
    </div>

    <div class="attendee-details__actions">
      <%= link_to "Back", attendees_organisation_event_path(@organisation, @event), class: "attendee-details__btn attendee-details__btn--ghost" %>
      <% if @attendee %>
        <%= link_to "Edit", edit_attendee_organisation_event_path(@organisation, @event, attendee_id: @attendee.id), class: "attendee-details__btn attendee-details__btn--primary" %>
      <% end %>
    </div>
  </header>

  <style>
    .attendee-details__banner {
      background-color: #ffe5e5;
      padding: 1rem;
      border-radius: 8px;
      margin-bottom: 1.5rem;
      text-align: center;
    }
  </style>

  <% if @attendee.banned? %>
    <div class="attendee-details__banner">
      <p class="attendee-details__banner-text">This attendee is banned from the event</p>
    </div>
  <% end %>

  <% if @attendee %>
    <div class="attendee-details__card">
      <dl class="attendee-details__list">
        <div class="attendee-details__row">
          <dt class="attendee-details__term">Name</dt>
          <dd class="attendee-details__definition"><%= @attendee.name %></dd>
        </div>

        <div class="attendee-details__row">
          <dt class="attendee-details__term">Age</dt>
          <dd class="attendee-details__definition"><%= @attendee.age %></dd>
        </div>

        <div class="attendee-details__row">
          <dt class="attendee-details__term">Diet</dt>
          <dd class="attendee-details__definition"><%= @attendee.diet.humanize %></dd>
        </div>

        <div class="attendee-details__row">
          <dt class="attendee-details__term">Allergies</dt>
          <dd class="attendee-details__definition"><%= @attendee.allergies.presence || "None" %></dd>
        </div>

        <div class="attendee-details__row">
          <% if !@attendee.banned? %>
            <dt class="attendee-details__term">Code</dt>
            <dd class="attendee-details__definition"><%= @attendee.code %></dd>
          <% else %>
            <dt class="attendee-details__term">Code</dt>
            <dd class="attendee-details__definition"><span style="color: red; font-weight: bold;">Void</span> - Banned</dd>
          <% end %>
        </div>

        <div class="attendee-details__row">
          <dt class="attendee-details__term">Waiver</dt>
          <dd class="attendee-details__definition">
            <span class="attendee-details__badge <%= @attendee.waiver_signed ? 'attendee-details__badge--success' : 'attendee-details__badge--muted' %>">
              <%= @attendee.waiver_signed ? "Signed" : "Not signed" %>
            </span>
            <span class="attendee-details__waiver-actions">
              <%= link_to "View waiver details", attendee_waiver_organisation_event_path(@organisation, @event, attendee_id: @attendee.id), class: "attendee-details__waiver-link" %>
              <% if @attendee.signed_waiver.attached? %>
                <%= link_to "Download copy", rails_blob_path(@attendee.signed_waiver, disposition: "attachment"), class: "attendee-details__waiver-download" %>
              <% end %>
            </span>
          </dd>
        </div>
      </dl>
    </div>
  <% else %>
    <p class="attendee-details__empty">Attendee not found.</p>
  <% end %>
</section>
