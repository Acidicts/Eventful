<h1>Attendee details</h1>

<% if @attendee %>
  <p>Name: <%= @attendee.name %></p>
  <p>Age: <%= @attendee.age %></p>
  <p>Diet: <%= @attendee.diet.humanize %></p>
  <p>Allergies: <%= @attendee.allergies || "None" %></p>
  <p>Code: <%= @attendee.code %></p>
  <p>Waiver Signed: <%= @attendee.waiver_signed ? "Yes" : "No" %></p>
  <p><%= link_to "View waiver details", attendee_waiver_organisation_event_path(@organisation, @event, attendee_id: @attendee.id) %></p>
  <% if @attendee.signed_waiver.attached? %>
    <p><%= link_to "Download signed copy", rails_blob_path(@attendee.signed_waiver, disposition: "attachment") %></p>
  <% end %>
<% else %>
  <p>Attendee not found.</p>
<% end %>

<% if @attendee %>
  <%= link_to "Edit this attendee", edit_attendee_organisation_event_path(
        @organisation,
        @event,
        attendee_id: @attendee.id
      ) %>
<% end %>
<%= link_to "Back to attendee list", attendees_organisation_event_path(@organisation, @event) %>