<h1>Event Info</h1>
<p>Event: <%= @event.id %> (organisation <%= @organisation.id %>)</p>

<div data-controller="qr-decoder"
     data-qr-decoder-url-value="<%= scan_organisation_event_path(@organisation, @event) %>"
     data-qr-decoder-code-param-field-value="code"
     data-qr-decoder-operation-value="get_info">

  <!-- manual entry form -->
  <form data-action="submit->qr-decoder#manualSubmit" style="margin-bottom:1em;">
    <label>
      Enter code manually:
      <input type="text" data-qr-decoder-target="manualInput" name="code" autocomplete="off" />
    </label>
    <button type="submit">Submit</button>
  </form>
  <video data-qr-decoder-target="video" data-action="click->qr-decoder#restart"
         style="width:100%;max-width:400px;border:1px solid #ccc"></video>
  <canvas data-qr-decoder-target="canvas" style="display:none"></canvas>

  <p>Decoded text: <span data-qr-decoder-target="output"></span></p>
</div>

<button type="button" data-action="click->qr-decoder#restart">
  Restart camera
</button>

<!-- details about the event go here -->