<section class="organisation-show">
  <header class="organisation-show__header">
    <h1><%= @organisation.name.to_s %></h1>
    <p>
      Top Team:
      <%= link_to @top_organisation.name, organisation_path(@top_organisation) %>
    </p>
  </header>

  <nav class="organisation-show__menu" aria-label="Top organisation teams">
    <h2><%= @top_organisation.name %> Teams</h2>
    <ul>
      <li>
        <%= link_to @top_organisation.name, organisation_path(@top_organisation), class: (@organisation.id == @top_organisation.id ? "is-active" : nil) %>
      </li>
      <% @menu_organisations.each do |team| %>
        <li>
          <%= link_to team.name, organisation_path(team), class: (@organisation.id == team.id ? "is-active" : nil) %>
        </li>
      <% end %>
    </ul>
  </nav>

  <div class="organisation-show__links">
    <% if has_permission?("organisation-update", organisation: @organisation) %>
      <%= link_to "Edit", edit_organisation_path(@organisation) %>
    <% end %>
    <%= link_to "Back", organisations_path %>
    <%= link_to "Events", organisation_events_path(@organisation) %>
    <%= link_to "Sub Teams", dashboard_sub_teams_organisation_path(@organisation) %>
  </div>
</section>
