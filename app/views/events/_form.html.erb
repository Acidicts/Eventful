<%= form_with(model: [organisation, event], local: true) do |form| %>
  <% if event.errors.any? %>
    <div id="error_explanation">
      <h2><%= pluralize(event.errors.count, "error") %> prohibited this event from being saved:</h2>
      <ul>
        <% event.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name %>
  </div>

  <div class="field">
    <%= form.label :description %>
    <%= form.text_field :description %>
  </div>

  <div class="field">
    <%= form.label :organiser %>
    <%= form.select :organiser_id,
                    @event.organisation.users.map { |u| [u.name, u.id] },
                    { include_blank: false },
                    { id: 'organiser-select' } %>
  </div>

  <div class="field">
    <%= form.label :capacity %>
    <%= form.number_field :capacity %>
  </div>

  <div class="field">
    <%= form.label :location %>
    <%= form.text_field :location, data: { controller: "location-autocomplete" }, autocomplete: "off", list: "location-results" %>
    <%= tag.datalist id: "location-results" %>
  </div>

  <div class="field">
    <%= form.label :start_date %>
    <%= form.datetime_select :start_date, include_blank: true %>
  </div>

  <div class="field">
    <%= form.label :end_date %>
    <%= form.datetime_select :end_date, include_blank: true %>
  </div>

  <div class="field">
    <%= form.label :waiver, "Waiver (PDF or TXT)" %>
    <%= form.file_field :waiver, accept: ".pdf,text/plain" %>
    <% if event.waiver.attached? %>
      <p>Current file: <%= link_to event.waiver.filename, rails_blob_path(event.waiver, disposition: "attachment") %></p>
    <% end %>
  </div>

  <div class="actions">
    <%= form.submit %>
  </div>
<% end %>
