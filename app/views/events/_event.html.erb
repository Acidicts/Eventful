<div class="event-card">
  <% if event.icon.attached? %>
    <div class="event-card__icon-wrap">
      <%= image_tag event.icon.variant(resize_to_limit: [64, 64]), class: "event-card__icon" if event.icon.variable? %>
    </div>
  <% end %>
  <div class="event-card__body">
    <% if event.name %>
      <h2 class="event-card__title"><%= event.name %></h2>
    <% end %>
    <% if event.description %>
      <p class="event-card__description"><%= event.description %></p>
    <% end %>
  </div>

  <%= button_to "Goto", organisation_event_path(event.organisation, event), method: :get, class: "btn btn-primary event-card__action" %>
</div>