<style>
    .event_container {
        border: 1px solid black;
        padding: 10px;
        margin: 10px;
        width: 15%;
        display: inline-flex;
    }
    .event_container h2 {
        font-size: 1em;
        margin: 0;
    }
</style>

<div class="event_container">
    <% if event.icon.attached? %>
    <div class="event-icon" style="margin-bottom:10px;">
        <div class="event-icon" style="margin-bottom:10px;">
            <%= image_tag event.icon.variant(resize_to_limit: [64, 64]) if event.icon.variable? %>
        </div>
        <%= button_to "Goto", organisation_event_path(event.organisation, event), method: :get, class: "btn btn-primary" %>
    </div>
    <% end %>
    <div style="margin-left:5px">        
        <% if event.name %>
            <h2><%= event.name %></h2>
        <% end %>
        <% if event.description %>
            <p><%= event.description %></p>
        <% end %>
    </div>
    
</div>