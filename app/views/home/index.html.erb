<style>
  .home-container {
    text-align: center;
    padding: 50px;
  }
</style>

<div class="home-container">
  <h1>Welcome to Eventful</h1>

  <% if current_user %>
    <p>You are logged in as <%= current_user.name || current_user.email %>.</p>
  <% else %>
      <style>
        #sign-in-button-menu-index {
          opacity: 0;
          animation: fadeIn 0.3s ease-out 0.15s forwards;
          background-color: #ec3750;
          padding: 1rem 2rem;
          font-size: 1.25rem;
          border: none;
          border-radius: 2rem;
          -webkit-font-smoothing: antialiased;
          color: white;
          text-shadow: 0 1px 2px rgba(0, 0, 0, 1);
          transition: all 0.3s ease;
        }
        #sign-in-button-menu-index:hover {
          transform: scale(1.05);
        }
      </style>
    <%= button_to 'Sign in with Hack Club', '/auth/hackclub', data: { turbo: false }, id: "sign-in-button-menu-index", class: "sign-in-button lexend" %>
  <% end %>
</div>