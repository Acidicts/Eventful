<style>
    .home-events-page {
        min-height: 100vh;
        padding: clamp(1rem, 2.6vw, 2.5rem);
        background:
            radial-gradient(circle at 10% 8%, rgba(72, 202, 228, 0.28) 0%, rgba(72, 202, 228, 0) 30%),
            radial-gradient(circle at 92% 20%, rgba(0, 119, 182, 0.16) 0%, rgba(0, 119, 182, 0) 34%),
            linear-gradient(155deg, #f8fdff, #eaf7fb);
    }

    .home-events-shell {
        width: min(1180px, 100%);
        margin: 0 auto;
    }

    .home-events-header {
        background: linear-gradient(165deg, rgba(255, 255, 255, 0.92), rgba(230, 247, 252, 0.9));
        border: 1px solid #c8eaf3;
        border-radius: 22px;
        padding: clamp(1.2rem, 2.5vw, 2rem);
        box-shadow: 0 26px 52px -36px rgba(2, 62, 138, 0.45);
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 1rem;
        align-items: end;
        margin-bottom: 1.2rem;
    }

    .home-events-intro {
        min-width: 0;
    }

    .home-events-kicker {
        margin: 0;
        width: fit-content;
        padding: 0.38rem 0.78rem;
        border-radius: 999px;
        border: 1px solid #95d8ea;
        background: #eaf8fc;
        color: var(--blue-dark);
        font-size: 0.76rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .home-events-title {
        margin: 0.62rem 0 0;
        font-family: "Lexend", "Segoe UI", sans-serif;
        font-size: clamp(1.85rem, 4vw, 3rem);
        line-height: 1.05;
        letter-spacing: -0.03em;
        color: var(--blue-very-dark);
    }

    .home-events-title span {
        color: var(--blue);
    }

    .home-events-subtitle {
        margin: 0.72rem 0 0;
        color: #315b7d;
        font-size: 1rem;
        line-height: 1.64;
        max-width: 66ch;
    }

    .home-events-summary {
        justify-self: end;
        text-align: right;
        border-left: 1px solid #bde2ed;
        padding-left: 0.95rem;
        color: #3b6788;
    }

    .home-events-summary strong {
        display: block;
        font-size: 2.1rem;
        line-height: 1;
        color: var(--blue-very-dark);
        font-family: "Lexend", "Segoe UI", sans-serif;
    }

    .home-events-summary span {
        font-size: 0.84rem;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        font-weight: 700;
    }

    .home-events-grid {
        margin: 0;
        padding: 0;
        list-style: none;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(265px, 1fr));
        gap: 1rem;
    }

    .home-event-card {
        display: flex;
        flex-direction: column;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #ccecf5;
        background: #ffffff;
        box-shadow: 0 16px 36px -28px rgba(2, 62, 138, 0.52);
        transition: transform 170ms ease, box-shadow 170ms ease, border-color 170ms ease;
    }

    .home-event-card:hover {
        transform: translateY(-2px);
        border-color: #9fd7e7;
        box-shadow: 0 22px 46px -28px rgba(2, 62, 138, 0.58);
    }

    .home-event-media {
        position: relative;
        aspect-ratio: 16 / 9;
        background: linear-gradient(140deg, #e3f7fc 0%, #c8edf6 100%);
        border-bottom: 1px solid #d5eff6;
        display: grid;
        place-items: center;
        overflow: hidden;
    }

    .home-event-media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .home-event-media-fallback {
        color: #1e5f86;
        font-size: 0.88rem;
        font-weight: 700;
        letter-spacing: 0.04em;
        text-transform: uppercase;
    }

    .home-event-body {
        padding: 0.95rem;
        display: flex;
        flex-direction: column;
        gap: 0.58rem;
        flex: 1;
    }

    .home-event-title {
        margin: 0;
        color: var(--blue-very-dark);
        font-size: 1.12rem;
        line-height: 1.32;
        font-weight: 700;
    }

    .home-event-description {
        margin: 0;
        color: #335e7f;
        font-size: 0.95rem;
        line-height: 1.55;
        flex: 1;
    }

    .home-event-meta {
        margin: 0;
        color: #4a7392;
        font-size: 0.86rem;
    }

    .home-event-link {
        margin-top: 0.25rem;
        align-self: flex-start;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.58rem 0.94rem;
        border-radius: 10px;
        text-decoration: none;
        color: #ffffff;
        background: linear-gradient(145deg, var(--blue), var(--blue-light));
        font-weight: 700;
        box-shadow: 0 10px 18px -13px rgba(2, 62, 138, 0.9);
    }

    .home-event-link:hover {
        background: linear-gradient(145deg, var(--blue-dark), var(--blue));
    }

    .home-events-empty {
        margin: 0;
        text-align: center;
        border: 1px solid #c9eaf3;
        border-radius: 16px;
        padding: 1.4rem;
        background: #ffffff;
        color: var(--blue-dark);
    }

    .home-events-empty h3 {
        margin: 0 0 0.4rem;
        color: var(--blue-very-dark);
    }

    .home-events-empty p {
        margin: 0;
    }

    @media (max-width: 860px) {
        .home-events-header {
            grid-template-columns: 1fr;
            align-items: start;
        }

        .home-events-summary {
            justify-self: start;
            text-align: left;
            border-left: none;
            border-top: 1px solid #bde2ed;
            padding-left: 0;
            padding-top: 0.7rem;
        }
    }

    @media (max-width: 640px) {
        .home-event-link {
            width: 100%;
        }
    }
</style>

<section class="home-events-page">
    <div class="home-events-shell">
        <header class="home-events-header">
            <div class="home-events-intro">
                <h1 class="home-events-title">Events Powered by <span>Eventful</span></h1>
                <p class="home-events-subtitle">
                    Explore active events and jump into each event page for attendance, check-in actions, and event details.
                </p>
            </div>

            <div class="home-events-summary">
                <strong><%= @events.size %></strong>
                <span>Active Listings</span>
            </div>
        </header>

        <% if @events.any? %>
            <ul class="home-events-grid">
                <% @events.each do |event| %>
                    <li class="home-event-card">
                        <div class="home-event-media">
                            <% if event.icon.attached? && event.icon.variable? %>
                                <%= image_tag event.icon.variant(resize_to_fill: [960, 540]), alt: "#{event.name} event image", loading: "lazy" %>
                            <% elsif event.icon.attached? %>
                                <%= image_tag event.icon, alt: "#{event.name} event image", loading: "lazy" %>
                            <% else %>
                                <span class="home-event-media-fallback">No Event Image</span>
                            <% end %>
                        </div>

                        <div class="home-event-body">
                            <h3 class="home-event-title"><%= event.name.presence || "Untitled Event" %></h3>

                            <p class="home-event-description">
                                <%= truncate(event.description.presence || "No description has been provided yet.", length: 155) %>
                            </p>

                            <p class="home-event-meta">
                                Organised by <strong><%= event.organiser.name %> - </strong>
                                <%= event.organisation.name %>
                            </p>

                            <%= link_to "View Event", organisation_event_path(event.organisation, event), class: "home-event-link" %>
                        </div>
                    </li>
                <% end %>
            </ul>
        <% else %>
            <div class="home-events-empty">
                <h3>No events available right now</h3>
                <p>Please check back soon for upcoming events.</p>
            </div>
        <% end %>
    </div>
</section>