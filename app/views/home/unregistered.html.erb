<style>
    :root {
        --welcome-bg-1: var(--blue-white);
        --welcome-bg-2: var(--blue-hint);
        --welcome-ink: var(--blue-very-dark);
        --welcome-muted: var(--blue-dark);
        --welcome-primary: var(--blue);
        --welcome-primary-dark: var(--blue-dark);
        --welcome-card: rgba(255, 255, 255, 0.8);
        --welcome-ring: rgba(0, 150, 199, 0.2);
    }

    .welcome-page {
        min-height: 100vh;
        padding: 2.5rem 1.25rem;
        display: grid;
        place-items: center;
        background:
            radial-gradient(circle at 14% 18%, rgba(72, 202, 228, 0.5) 0%, rgba(72, 202, 228, 0) 34%),
            radial-gradient(circle at 88% 82%, rgba(0, 180, 216, 0.35) 0%, rgba(0, 180, 216, 0) 36%),
            linear-gradient(125deg, var(--welcome-bg-1), var(--welcome-bg-2));
        color: var(--welcome-ink);
        font-family: "Lexend", "Segoe UI", sans-serif;
    }

    .welcome-shell {
        width: min(1080px, 100%);
        background: var(--welcome-card);
        border: 1px solid rgba(255, 255, 255, 0.65);
        border-radius: 28px;
        box-shadow: 0 30px 90px -45px rgba(3, 62, 138, 0.45);
        backdrop-filter: blur(5px);
        overflow: hidden;
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        animation: page-in 500ms ease-out;
    }

    .welcome-illustration {
        position: relative;
        background: linear-gradient(170deg, #d8f5fb 0%, #bdebf4 100%);
        padding: 2rem;
        display: grid;
        place-items: center;
    }

    .welcome-illustration::before,
    .welcome-illustration::after {
        content: "";
        position: absolute;
        border-radius: 999px;
        background: rgba(255, 255, 255, 0.32);
    }

    .welcome-illustration::before {
        width: 190px;
        height: 190px;
        top: -65px;
        left: -40px;
    }

    .welcome-illustration::after {
        width: 150px;
        height: 150px;
        bottom: -45px;
        right: -35px;
    }

    .welcome-illustration img {
        width: min(320px, 100%);
        height: auto;
        filter: drop-shadow(0 26px 28px rgba(2, 62, 138, 0.22));
        transform: translateY(0);
        animation: float 3.4s ease-in-out infinite;
    }

    .welcome-content {
        padding: clamp(1.8rem, 2.8vw, 3.3rem);
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .welcome-label {
        display: inline-flex;
        width: fit-content;
        margin-bottom: 1rem;
        padding: 0.35rem 0.8rem;
        border-radius: 999px;
        background: #e7f8fc;
        border: 1px solid #9ddfed;
        color: var(--blue-dark);
        font-size: 0.77rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-weight: 800;
    }

    .welcome-content h1 {
        margin: 0;
        font-family: "Lexend", "Segoe UI", sans-serif;
        font-size: clamp(2rem, 4.2vw, 3.35rem);
        line-height: 1.06;
        font-weight: 700;
    }

    .welcome-content h1 span {
        color: var(--welcome-primary);
    }

    .welcome-content p {
        margin: 1rem 0 0;
        color: var(--welcome-muted);
        max-width: 52ch;
        font-size: 1.02rem;
        line-height: 1.7;
    }

    .welcome-points {
        margin: 1.25rem 0 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 0.65rem;
    }

    .welcome-points li {
        position: relative;
        padding-left: 1.4rem;
        color: var(--blue-very-dark);
    }

    .welcome-points li::before {
        content: "";
        width: 0.56rem;
        height: 0.56rem;
        border-radius: 50%;
        background: linear-gradient(160deg, var(--blue-lighter), var(--blue));
        position: absolute;
        left: 0;
        top: 0.46rem;
    }

    .welcome-actions {
        margin-top: 1.7rem;
        display: flex;
        flex-wrap: wrap;
        gap: 0.8rem;
    }

    .welcome-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        padding: 0.8rem 1.2rem;
        text-decoration: none;
        font-weight: 700;
        transition: transform 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
    }

    .welcome-btn-primary {
        background: linear-gradient(145deg, var(--welcome-primary), var(--blue-light));
        color: #fff;
        box-shadow: 0 14px 28px -17px rgba(3, 62, 138, 0.7);
    }

    .welcome-btn-primary:hover {
        transform: translateY(-1px);
        background: linear-gradient(145deg, var(--welcome-primary-dark), var(--blue-very-dark));
    }

    .welcome-btn-secondary {
        border: 1px solid #8ed6e7;
        background: #eaf9fd;
        color: var(--blue-dark);
    }

    .welcome-btn-secondary:hover {
        transform: translateY(-1px);
        box-shadow: 0 0 0 4px var(--welcome-ring);
    }

    @keyframes float {
        0%,
        100% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-8px);
        }
    }

    @keyframes page-in {
        from {
            opacity: 0;
            transform: translateY(14px) scale(0.99);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    @media (max-width: 930px) {
        .welcome-shell {
            grid-template-columns: 1fr;
        }

        .welcome-illustration {
            padding: 2.2rem 1.4rem 1.3rem;
        }
    }

    @media (max-width: 560px) {
        .welcome-page {
            padding: 1rem;
        }

        .welcome-shell {
            border-radius: 20px;
        }

        .welcome-content {
            padding: 1.35rem;
        }

        .welcome-actions {
            flex-direction: column;
        }

        .welcome-btn {
            width: 100%;
        }
    }

    .features ul {
        display: inline-flex;
        width: 100%;
        margin: 3rem auto 2rem;
        margin-top: 0.1rem;
        padding: 0 1rem;
        justify-content: space-evenly;
    }

    .features h2 {
        text-align: center;
        font-family: "Lexend", "Segoe UI", sans-serif;
        font-size: 1.8rem;
    }

    .features {
        display: flex;
        flex-direction: column;
        padding: 1rem;
        align-items: center;
        background-color: var(--blue);
        color: #d8d8d8;
    }

    .features li {
        width:20%;
        margin:1rem;
        text-decoration: none;
        color: #fff;
        font-size: 1.1rem;
        background-color: var(--blue-light);
        list-style-type: none;
        padding: 1.2rem;
        height:100px;
        border-radius: 12px;
        border: 2px solid rgba(255, 255, 255, 0.65);
        transition: all 180ms ease;
    }

    .features li:hover {
        background-color: var(--blue);
        color: #fff;
        transform: translateY(-3px);
        box-shadow: 0 14px 28px -17px rgba(3, 62, 138, 0.7);
    }
</style>

<section class="welcome-page">
    <div class="welcome-shell">
        <div class="welcome-illustration">
            <img src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png" alt="Eventful attendee check-in illustration">
        </div>

        <div class="welcome-content">
            <span class="welcome-label">Smart Event Check-In</span>

            <h1>
                Welcome to <span>Eventful</span><br>
                where queues become quick hellos.
            </h1>

            <p>
                Run smooth arrivals, verify attendees in seconds, and keep your front desk in sync from the first guest to the final session.
            </p>

            <ul class="welcome-points">
                <li>Fast attendee check-in with QR support.</li>
                <li>Real-time attendance visibility for your team.</li>
                <li>Designed for conferences, workshops, and private events.</li>
            </ul>

            <div class="welcome-actions">
                <%= button_to "Sign in", '/auth/hackclub', data: { turbo: false }, class: "welcome-btn welcome-btn-primary" %>
                <%= link_to "Browse Events", landing_events_path, class: "welcome-btn welcome-btn-secondary" %>
            </div>
        </div>
    </div>
</section>
<section class="features">
    <h2>Features</h2>
    <ul>
        <li>QR code scanning for quick check-ins.</li>
        <li>Manual code entry for flexibility.</li>
        <li>Real-time attendance tracking.</li>
        <li>Intuitive dashboard for event management.</li>
    </ul>
</section>