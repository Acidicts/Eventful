<div class="container">
  <h1>Attendee Portal</h1>
  <% if flash[:alert] %>
    <p class="alert"><%= flash[:alert] %></p>
  <% end %>
  <%= form_with url: attendee_portal_login_path, method: :post, local: true do |f| %>
    <label for="code">Enter your attendee code</label>
    <%= f.text_field :code, id: "code" %>
    <%= f.submit "Sign in" %>
  <% end %>
</div>