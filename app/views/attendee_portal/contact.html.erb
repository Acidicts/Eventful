<style>
    #queries {
        margin-bottom: 20px;
        width: 50%;
    }
    .message {
        display: flex;
        flex-direction: column;
        border: 1px solid #c9c9c9;
        border-radius: 6px;
        padding: 15px;
        padding-bottom: 5px;
        margin-bottom: 15px;
        background-color: #f9f9f9;
        width: 80%;
        margin-left: 20px;
        margin-top: 20px;
    }
    .message-text {
        margin-left: 10px;
    }
    .message-timestamp {
        text-align: right;
        margin-top: 10px;
        color: #888;
    }
    .badge {
        margin-left: auto;
        align-self: start;
        border-radius: 12px;
    }
    .badge-green {
        background-color: #d4edda;
        color: #155724;
        padding: 5px 10px;
    }
    .badge-red {
        background-color: #f8d7da;
        color: #721c24;
        padding: 5px 10px;
    }
    .answer {
        margin-top: 10px;
        padding: 10px;
        border-left: 3px solid #c9c9c9;
        background-color: #e9ecef;
    }
    .badge-container {
        display: flex;
        justify-content: flex-end;
        margin-bottom: -3rem;
    }
    #message-box-stuff {
        display: flex;
        flex-direction: column;
        width:50%;
        padding-left: 20px;
        border: 1px solid #969696;
        border-radius: 6px; 
        background-color: #f4f7fa;
        margin: 20px;
    }
</style>

<div style="width:100%; display:flex; flex-direction:row; align-items:center;">
    <div id="queries">
        <% for msg in @messages %>
            <%= render "message", message: msg, user: @attendee %>
        <% end %>
    </div>
    <div id="message-box-stuff">
        <div id="new-message" style="width:100%; padding: 20px; margin: 20px; border-left: 1px solid #ddd;">
            <%= form_with url: attendee_portal_contact_path, method: :post, local: true do |form| %>
                <div class="field">
                    <%= form.label :message, "Your Message" %>
                    <%= form.text_area :message, rows: 4 %>
                </div>
                <%= form.submit "Send Message" %>
            <% end %>
        </div>
        <div id="focused-message">
            <% if @messages.any? %>
                <%= render "message-extended", message: @messages.first, user: @attendee %>
            <% else %>
                <p>No messages to display.</p>
            <% end %>
        </div>
    </div>
</div>